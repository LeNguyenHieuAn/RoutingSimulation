@startuml
title UML triển khai - Routing Simulation C++20
skinparam classAttributeIconSize 0
left to right direction
package "Control Plane" {
  interface RoutingStrategy {
    + calculateRoutes(Router&, const Topology&) : void
    + getName() const : string
  }
  class StaticRouting
  class ShortestPathRouting
  class CostBasedRouting
  class StrategyFactory {
    + {static} createStrategy(type : string) : unique_ptr<RoutingStrategy>
  }
  RoutingStrategy <|.. StaticRouting
  RoutingStrategy <|.. ShortestPathRouting
  RoutingStrategy <|.. CostBasedRouting
  StrategyFactory ..> RoutingStrategy : creates
}
package "Data Plane" {
  class Router {
    - ipAddress_ : string
    - interfaces_ : unordered_map<string, shared_ptr<Interface>>
    - routingTable_ : RoutingTable
    - staticRoutes_ : RoutingTable
    - strategy_ : unique_ptr<RoutingStrategy>
    + updateRoutes(topology : const Topology&) : void
    + forwardPacket(packet : Packet&) : string
  }
  class Interface {
    - id_ : string
    - linkIP_ : string
    - linkInterface_ : string
    - isUp_ : bool
    - linkCost_ : long long
    - peerInterface_ : weak_ptr<Interface>
  }
  class RoutingTable {
    - routes_ : unordered_map<string, Route>
    + addRoute(const Route&) : void
    + findRoute(destIP : string) : Route
  }
  class Route {
    - destIP_ : string
    - nextIP_ : string
    - interfaceId_ : string
    - hopCount_ : int
    - cost_ : long long
  }
  class Packet {
    - srcIP_ : string
    - destIP_ : string
    - payload_ : string
    - ttl_ : int
  }
  Router *-- "2" RoutingTable : active / static
  Router o-- "0..*" Interface : shared ownership
  Interface --> "0..1" Interface : peer (weak_ptr)
  RoutingTable *-- "0..*" Route
  Router --> "1" RoutingStrategy : active strategy
  Router ..> Packet : forwards
}
package "Management & Persistence" {
  class Administrator {
    - routers_ : Topology
    - logger_ : TextLogger
    + convergeNetwork() : void
    + simulatePacketTransmission(...) : void
    + setLinkCost(...) : void
  }
  class CsvTopologyStorage
  class TextLogger
  Administrator o-- "0..*" Router : manages
  Administrator *-- TextLogger
  Administrator *-- CsvTopologyStorage
  CsvTopologyStorage ..> Router : load/save
}
package "Exceptions" {
  class "std::runtime_error" as RuntimeError
  class NoRouteException
  class InterfaceDownException
  RuntimeError <|-- NoRouteException
  RuntimeError <|-- InterfaceDownException
  Router ..> NoRouteException : throws
  Router ..> InterfaceDownException : throws
}
@enduml
